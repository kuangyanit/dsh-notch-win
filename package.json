{
  "name": "@dsh-external/dsh-notch-win",
  "version": "0.1.0",
  "description": "DeepSeek Harness Windows 灵动岛：状态在宿主进程计算，顶层桌面 app 只负责画",
  "author": "kuangyanit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuangyanit/dsh-notch-win.git"
  },
  "homepage": "https://github.com/kuangyanit/dsh-notch-win",
  "bugs": {
    "url": "https://github.com/kuangyanit/dsh-notch-win/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "electron",
    "windows",
    "notch",
    "island"
  ],
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "app/dist"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "gen-protocol": "node scripts/gen-app-protocol.mjs",
    "check-protocol": "node scripts/gen-app-protocol.mjs --check"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": ">=18"
  }
}
